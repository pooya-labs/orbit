# Browser-visible API endpoint for local development (only set when connecting the UI)
NEXT_PUBLIC_ORBIT_API_URL=http://localhost:8080

# Optional browser OIDC public client (Authorization Code + PKCE; never add a client secret).
# Register this callback URL with your identity provider.
# NEXT_PUBLIC_ORBIT_OIDC_ISSUER=https://identity.example.com/
# NEXT_PUBLIC_ORBIT_OIDC_CLIENT_ID=orbit-browser
# NEXT_PUBLIC_ORBIT_OIDC_AUDIENCE=orbit-api
# NEXT_PUBLIC_ORBIT_OIDC_SCOPE=openid profile email
# NEXT_PUBLIC_ORBIT_OIDC_REDIRECT_URI=https://pooya-labs.github.io/orbit/auth/callback/

# Never commit real secrets. Copy this file to .env.local for local overrides.

# Go API server
ORBIT_HTTP_ADDR=:8080
ORBIT_ENVIRONMENT=development
ORBIT_VERSION=0.10.0
# Required in staging/production for shared PostgreSQL-backed API rate limiting; optional only in local development.
ORBIT_DATABASE_URL=postgres://orbit:orbit_local_only@localhost:5432/orbit?sslmode=disable
ORBIT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://pooya-labs.github.io
ORBIT_RATE_LIMIT_PER_MINUTE=120
ORBIT_OIDC_ROLES_CLAIM=roles

# Optional OIDC resource-server configuration. Set BOTH values to enable auth in development.
# Staging and production require both values and refuse to start without valid discovery/JWKS.
# ORBIT_OIDC_ISSUER=https://identity.example.com/
# ORBIT_OIDC_AUDIENCE=orbit-api

# Optional telemetry read APIs (start the observability Docker Compose profile)
ORBIT_PROMETHEUS_URL=http://localhost:9090
ORBIT_LOKI_URL=http://localhost:3100
ORBIT_TEMPO_URL=http://localhost:3200

# Authenticated workload OTLP ingestion. Configure ALL values to enable the dedicated gateways.
# The workload issuer must issue RFC 9068 at+jwt access tokens for an audience distinct from ORBIT_OIDC_AUDIENCE.
# Production/staging require these values, PostgreSQL, and private Collector endpoints.
# ORBIT_WORKLOAD_OIDC_ISSUER=https://identity.example.com/
# ORBIT_WORKLOAD_OIDC_AUDIENCE=orbit-ingestion
# ORBIT_INGESTION_HTTP_ADDR=127.0.0.1:4319
# ORBIT_INGESTION_GRPC_ADDR=127.0.0.1:4320
# ORBIT_COLLECTOR_OTLP_HTTP_URL=http://otel-collector:4318
# ORBIT_COLLECTOR_OTLP_GRPC_ENDPOINT=otel-collector:4317
