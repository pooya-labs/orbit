# Browser-visible API endpoint for local development (only set when connecting the UI)
NEXT_PUBLIC_ORBIT_API_URL=http://localhost:8080

# Never commit real secrets. Copy this file to .env.local for local overrides.

# Go API server
ORBIT_HTTP_ADDR=:8080
ORBIT_ENVIRONMENT=development
ORBIT_VERSION=0.7.0
ORBIT_DATABASE_URL=postgres://orbit:orbit_local_only@localhost:5432/orbit?sslmode=disable
ORBIT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://pooya16pg-spec.github.io

# Optional telemetry read APIs (start the observability Docker Compose profile)
ORBIT_PROMETHEUS_URL=http://localhost:9090
ORBIT_LOKI_URL=http://localhost:3100
ORBIT_TEMPO_URL=http://localhost:3200
