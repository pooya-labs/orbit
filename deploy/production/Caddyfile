		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy keycloak:8080
}

{$ORBIT_OTLP_HTTP_DOMAIN} {
	reverse_proxy api:4319
}

{$ORBIT_OTLP_GRPC_DOMAIN} {
	reverse_proxy h2c://api:4320
}
