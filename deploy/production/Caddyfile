{
	servers {
		protocols h1 h2
	}
}

{$ORBIT_API_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
	}
	@worker_api {
		path /api/v1/* /health/ready
		header X-ORBIT-Gateway-Secret {$ORBIT_WORKER_GATEWAY_SECRET}
	}
	handle @worker_api {
		reverse_proxy api:8080 {
			header_up -X-ORBIT-Gateway-Secret
			header_up X-ORBIT-Client-IP {http.request.header.X-ORBIT-Client-IP}
		}
	}
	@blocked_api path /api/v1/* /health/ready
	handle @blocked_api {
		respond "Forbidden" 403
	}
	@liveness path /health/live
	handle @liveness {
		reverse_proxy api:8080
	}
	handle {
		respond "Not Found" 404
	}
}

{$ORBIT_AUTH_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy keycloak:8080
}

{$ORBIT_OTLP_HTTP_DOMAIN} {
	reverse_proxy api:4319
}

{$ORBIT_OTLP_GRPC_DOMAIN} {
	reverse_proxy h2c://api:4320
}
