{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "orbit-native-runtime",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "ORBIT_READ_LIMITER",
      "namespace_id": "20261107140",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "ORBIT_WRITE_LIMITER",
      "namespace_id": "20261107141",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    },
    "redact_query_string": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://pooya-labs.github.io",
    "ORBIT_OIDC_ISSUER": "https://REPLACE-WITH-OIDC-ISSUER",
    "ORBIT_OIDC_AUDIENCE": "https://pooya-labs.github.io/orbit-api",
    "ORBIT_OIDC_ROLES_CLAIM": "roles"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit-native",
      "database_id": "REPLACE-WITH-CREATED-D1-DATABASE-ID",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ORBIT_REQUEST_EVENTS",
      "dataset": "orbit_native_requests"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  }
}
